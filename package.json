{
  "name": "mastra-descript",
  "version": "1.0.0",
  "description": "Mastra agent template for the Descript API: import media, run Underlord edits, publish, with credit safety and spec-verified job handling.",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "eval": "node --env-file=.env --import tsx/esm scripts/eval.ts",
    "descript:ping": "node --env-file=.env --import tsx/esm scripts/descript-ping.ts",
    "descript:verify": "node --env-file=.env --import tsx/esm scripts/descript-verify.ts",
    "score:list": "mastra scorers list",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.125",
    "@descript/platform-cli": "^0.14.0",
    "@mastra/auth": "^1.1.3",
    "@mastra/core": "^1.75.0",
    "@mastra/duckdb": "^1.13.0",
    "@mastra/editor": "^0.15.6",
    "@mastra/evals": "^1.10.5",
    "@mastra/fastembed": "^1.3.2",
    "@mastra/libsql": "^1.25.1",
    "@mastra/loggers": "^1.3.5",
    "@mastra/mcp": "^2.2.0",
    "@mastra/memory": "^1.36.0",
    "@mastra/observability": "^1.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "mastra": "^1.33.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "onnxruntime-node@1.26.0": true
  }
}
