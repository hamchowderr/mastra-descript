# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Min 32 chars. Generate with: openssl rand -hex 32
APP_SECRET=

# ──────────────────────────────────────────────
# Storage — libSQL / Turso (required, default applies if unset)
# ──────────────────────────────────────────────
# Local: leave unset — defaults to a local file: DB (./mastra.db), no server needed.
# Hosted (Turso): libsql://<db-name>-<org>.turso.io
TURSO_DATABASE_URL=file:./mastra.db
# Required alongside a libsql:// TURSO_DATABASE_URL; omit for local file: DBs.
TURSO_AUTH_TOKEN=
# DuckDB file for observability (traces/metrics). Docker sets /app/data/mastra.duckdb (persistent volume).
# DUCKDB_PATH=./mastra.duckdb
# Want Postgres/pgvector (Supabase) instead? See docs/postgres.md.

# ──────────────────────────────────────────────
# Descript CLI workspace — sandbox root for the agent's execute_command tool
# ──────────────────────────────────────────────
WORKSPACE_ROOT=./agent-workspace

# ──────────────────────────────────────────────
# Dolt — versioned business data (mysql2 → dolt sql-server)
# In the compose stack this is the `dolt` service; DOLT_HOST/PORT/USER are set
# there automatically. Set DOLT_PASSWORD (+ optional DOLT_DATABASE) for compose.
# Leave blank to run without Dolt (the Dolt tools error clearly if called).
# ──────────────────────────────────────────────
DOLT_PASSWORD=
DOLT_DATABASE=appdb
# When NOT using compose, also set: DOLT_HOST, DOLT_PORT, DOLT_USER

# ──────────────────────────────────────────────
# LLM providers (at least one required)
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ──────────────────────────────────────────────
# AIMock — deterministic LLM mocking
# Run: npx @copilotkit/aimock --config aimock.json
# ──────────────────────────────────────────────
USE_AIMOCK=false
AIMOCK_URL=http://localhost:4010
# Required when USE_AIMOCK=true — @ai-sdk/openai reads this at module load time,
# before configureAIMock() runs. Set to match AIMOCK_URL + /v1.
# OPENAI_BASE_URL=http://localhost:4010/v1

# ──────────────────────────────────────────────
# E2E (only used during e2e runs)
# ──────────────────────────────────────────────
E2E_BASE_URL=http://localhost:4111

# ──────────────────────────────────────────────
# Descript API (required)
# ──────────────────────────────────────────────
# Bearer token from Descript Settings → API tokens. Scoped to a single Drive.
DESCRIPT_API_TOKEN=

# Optional Descript settings (sensible defaults applied if omitted)
# DESCRIPT_BASE_URL=https://descriptapi.com/v1
# DESCRIPT_TIMEOUT_MS=60000
# DESCRIPT_RETRIES=3
# DESCRIPT_POLL_INTERVAL_MS=3000
# DESCRIPT_POLL_MAX_ATTEMPTS=600
# DESCRIPT_HEALTHCHECK_ON_BOOT=false
# DESCRIPT_AGENT_MODEL=claude-haiku  # default Underlord model for agentEdit (an alias that tracks the current low-cost Haiku); see GET /agent/models (listAgentModels)
# DESCRIPT_CREDIT_CAP=  # optional: abort agentEdit once this many AI credits are spent this session

# ──────────────────────────────────────────────
# Mastra
# ──────────────────────────────────────────────
# Recommended for locked-down corporate networks where PostHog is blocked
MASTRA_TELEMETRY_DISABLED=1
# Only set if connecting to hosted Mastra Studio
# MASTRA_CLOUD_ACCESS_TOKEN=

# ──────────────────────────────────────────────
# Auth — JWT (@mastra/auth), shared HMAC secret. NOT an external provider.
# When set, ALL /api/* routes AND Studio require a Bearer JWT signed with this
# secret. `/health` and `/api/auth/*` stay public (healthchecks + Studio login).
# Leave blank for open local dev. Generate the secret with: openssl rand -hex 32
# ──────────────────────────────────────────────
# MASTRA_JWT_SECRET=
# Mint a client/Studio token (HS256) signed with the secret above:
#   node -e "import('jsonwebtoken').then(j=>console.log(j.default.sign({sub:'client'},process.env.MASTRA_JWT_SECRET)))"
# or use jwt.io's JWT Encoder. Clients send it as: Authorization: Bearer <jwt>
# In Studio: Settings → Headers → Add Header → Authorization = Bearer <jwt>
